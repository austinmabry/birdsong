# Settings for docker-compose.tunnel.yml. Copy this file to .env, fill it in, and keep it private:
#   cp .env.example .env && chmod 600 .env
# .env is listed in .gitignore and .dockerignore, so it is never committed or built into the image.

# Where the birds come from: set ONE of these two.
# - BirdNET-Go: its address as the Birdsong container can reach it (the server's IP, not localhost).
# - A BirdWeather station, such as a PUC: the number at the end of its public page,
#   https://app.birdweather.com/stations/12345 (the whole address works too). Leave BIRDNET_URL empty.
BIRDNET_URL=http://192.168.1.50:8080
BIRDWEATHER_STATION=

# The tunnel token from Cloudflare (the long string starting eyJ, from Networking > Tunnels).
# Anyone holding it can run your tunnel, so treat it like a password.
TUNNEL_TOKEN=

# The LAN door: Birdsong at http://<this server>:8089 on your home network, with no
# sign-in. Never forward this port on your router. LAN_BIND=127.0.0.1 makes it reachable from
# this server only (the tunnel keeps working); on a server with a public IP address of its own,
# set LAN_BIND to its LAN address, since Docker publishes ports past firewalls such as ufw.
LAN_PORT=8089
LAN_BIND=0.0.0.0

# How visitors get in through the internet door (docs/cloudflare-tunnel.md, step 1):
#  - Sign-in with Cloudflare Access (an emailed code): REQUIRE_CLOUDFLARE_ACCESS=true and
#    ALLOWED_IPS empty. The internet door then refuses anything that did not pass Access.
#  - By home internet address, no sign-in: REQUIRE_CLOUDFLARE_ACCESS=false and list the
#    addresses in ALLOWED_IPS, separated by commas (IPv4 and IPv6 addresses or ranges).
#  - Both: REQUIRE_CLOUDFLARE_ACCESS=true with ALLOWED_IPS; listed homes need no sign-in.
REQUIRE_CLOUDFLARE_ACCESS=true
ALLOWED_IPS=
