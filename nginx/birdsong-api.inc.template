# The BirdNET-Go calls the page makes, and nothing else: every one a read-only GET, each with
# exactly the query string the page sends. BirdNET-Go has hundreds of other routes (settings,
# deleting detections, restarting, signing in) and many other query options (denoising,
# custom spectrogram sizes, large result pages); none of them can be reached through here.
# Rendered at container start: the BIRDNET_URL placeholder comes from the environment.
#
# In the patterns: a date is 2026-11-13; a species is its scientific name as the page
# encodes it, e.g. Turdus%20merula.

location = /api/v2/analytics/species/summary {
    if ($args !~ "^(start_date=[0-9]{4}-[0-9]{2}-[0-9]{2}&end_date=[0-9]{4}-[0-9]{2}-[0-9]{2})?$") { return 400; }
    include /etc/nginx/birdsong/proxy.conf;
    proxy_pass ${BIRDNET_URL};
}
location = /api/v2/analytics/species/daily {
    if ($args !~ "^date=[0-9]{4}-[0-9]{2}-[0-9]{2}$") { return 400; }
    include /etc/nginx/birdsong/proxy.conf;
    proxy_pass ${BIRDNET_URL};
}
location = /api/v2/analytics/time/daily {
    if ($args !~ "^species=[A-Za-z][A-Za-z.'()-]*(%20[A-Za-z.'()-]+){0,6}&start_date=[0-9]{4}-[0-9]{2}-[0-9]{2}&end_date=[0-9]{4}-[0-9]{2}-[0-9]{2}$") { return 400; }
    include /etc/nginx/birdsong/proxy.conf;
    proxy_pass ${BIRDNET_URL};
}
location = /api/v2/analytics/time/distribution/hourly {
    if ($args !~ "^species=[A-Za-z][A-Za-z.'()-]*(%20[A-Za-z.'()-]+){0,6}&start_date=[0-9]{4}-[0-9]{2}-[0-9]{2}&end_date=[0-9]{4}-[0-9]{2}-[0-9]{2}$") { return 400; }
    include /etc/nginx/birdsong/proxy.conf;
    proxy_pass ${BIRDNET_URL};
}
location = /api/v2/species {
    if ($args !~ "^scientific_name=[A-Za-z][A-Za-z.'()-]*(%20[A-Za-z.'()-]+){0,6}$") { return 400; }
    include /etc/nginx/birdsong/proxy.conf;
    proxy_pass ${BIRDNET_URL};
}
# The latest recordings of one species; the page asks for four.
location = /api/v2/detections {
    if ($args !~ "^species=[A-Za-z][A-Za-z.'()-]*(%20[A-Za-z.'()-]+){0,6}&numResults=[0-9]{1,2}&includeWeather=true$") { return 400; }
    include /etc/nginx/birdsong/proxy.conf;
    proxy_pass ${BIRDNET_URL};
}
# A recording and its spectrogram, by detection number.
location ~ "^/api/v2/spectrogram/[0-9]{1,19}$" {
    if ($args != "size=md") { return 400; }
    include /etc/nginx/birdsong/proxy.conf;
    proxy_pass ${BIRDNET_URL};
}
location ~ "^/api/v2/audio/[0-9]{1,19}$" {
    if ($request_uri ~ "\?") { return 400; }
    include /etc/nginx/birdsong/proxy.conf;
    proxy_pass ${BIRDNET_URL};
}
# BirdNET-Go's photo of a species, by scientific name: used when no plate is found.
location ~ "^/api/v2/media/image/[A-Za-z][A-Za-z -]{0,100}$" {
    if ($request_uri ~ "\?") { return 400; }
    include /etc/nginx/birdsong/proxy.conf;
    proxy_pass ${BIRDNET_URL};
}

location /api/ { return 404; }
